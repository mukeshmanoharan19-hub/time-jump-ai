# Microsoft Azure AD (Phase 1+)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/auth/callback

# OpenAI (Phase 2+)
OPENAI_API_KEY=

# Session TTL
SESSION_TTL_HOURS=24

# Backend — use localhost:5433 when running API on the host; Docker services use postgres:5432
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5433/timejump
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=

# App
CORS_ORIGINS=http://localhost:3000
APP_SECRET_KEY=change-me-in-production
